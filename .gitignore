# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/

# 运行时数据（含上传文件、识别结果、证书私钥、数据库）
data/

# 本地配置与密钥
config.json
config.local.json
*.secret

# 编辑器/系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 临时
.scratch/
*.log

# 测试临时目录（固定在项目内，避免系统临时目录权限问题）
.pytest-tmp/

# 冒烟测试临时目录
.smoke/

# 第三方运行时（Umi-OCR、离线依赖包，体积大，不入库）
vendor/
